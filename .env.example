# Claude API key (https://console.anthropic.com). Without it the app falls back to simple keyword ranking.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Shared secret for the web app. REQUIRED when you deploy it so your phone can reach it safely.
APP_TOKEN=change-me

# How many days of mail to pull and how often to auto-sync (hours)
LOOKBACK_DAYS=3
SYNC_EVERY_HOURS=6

# Set to 1 to run with sample emails and no Gmail (for trying the UI)
DEMO=0
